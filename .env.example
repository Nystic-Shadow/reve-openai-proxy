# ==============================================================================
# Reve OpenAI Multi-Account Proxy Configuration
# ==============================================================================

# Server Port (Default: 5674)
PORT=5674
HOST=0.0.0.0

# Optional: Set a secret API key to enforce strict authorization
# If left blank or commented out, any dummy/random key is accepted automatically
# PROXY_API_KEY=sk-proxy-reve-123456

# Max retries across accounts on failure
MAX_RETRIES=3

# ==============================================================================
# REVE MULTI-ACCOUNT TOKENS
# Extract in browser console at app.reve.com: localStorage.getItem('reve:bearer_token')
# Single Account Mode: 1 Token
# Multi-Account Pool Mode: 2+ Tokens (Auto Round-Robin with failover)
# ==============================================================================
TOKEN_1=v2.login-your_first_account_token_here
TOKEN_2=v2.login-your_second_account_token_here
TOKEN_3=v2.login-your_third_account_token_here
